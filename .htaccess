# Interne Dateien nicht über den Browser ausliefern.
# Wichtig, wenn Clipo per "git clone" auf dem Server liegt.

# Git-Ordner und Dotfiles (.git/, .gitignore, .dockerignore, ...)
RedirectMatch 404 /\.(git|docker|claude)

# Doku, Docker-Dateien und Vorlagen
<FilesMatch "(\.md$|^VERSION$|^Dockerfile$|^docker-compose\.ya?ml$|^config\.sample\.php$)">
    Require all denied
</FilesMatch>

# includes/ enthält nur Bausteine, die von anderen Seiten geladen werden
RedirectMatch 404 ^(.*/)?includes/

# storage/ enthält Update-Backups (komplette Programmdateien)
RedirectMatch 404 ^(.*/)?storage/

# Sicherheits-Header (nur wenn mod_headers verfügbar ist)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
